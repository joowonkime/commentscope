# Replace __PUBLIC_HOST__ with this evaluation's certified host.
map "$request_method:$uri:$http_sec_fetch_mode:$http_sec_fetch_dest" $commentscope_fetch_site {
    default $http_sec_fetch_site;
    "GET:/mvp:navigate:document" none;
    "GET:/mvp/:navigate:document" none;
}
map $http_origin $commentscope_origin_ok {
    default 0;
    "" 1;
    "https://__PUBLIC_HOST__" 1;
}
map $commentscope_fetch_site $commentscope_site_ok {
    default 0;
    "" 1;
    none 1;
    same-origin 1;
}
map $uri $commentscope_ui_file {
    default "";
    /mvp /mvp.html;
    /mvp/ /mvp.html;
    /mvp/app.css /mvp.css;
    /mvp/app.js /mvp.js;
}

server {
    listen 80;
    server_name __PUBLIC_HOST__;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/commentscope-acme; }
    location / { return 308 https://__PUBLIC_HOST__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/letsencrypt/live/commentscope-qa/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/commentscope-qa/privkey.pem;

    if ($host != "__PUBLIC_HOST__") { return 403; }
    location = / { return 302 /mvp; }

    # Only the public presentation can change inside a running assessment.
    location ~ ^/mvp(?:/?|/app\.(?:js|css))$ {
        if ($commentscope_origin_ok = 0) { return 403; }
        if ($commentscope_site_ok = 0) { return 403; }
        limit_except GET { deny all; }
        root /srv/commentscope-ui/current;
        try_files $commentscope_ui_file =404;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' https://i.ytimg.com; font-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    }
    location ~ ^/(?:mvp/assets/|api/v1/) {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header Sec-Fetch-Site $commentscope_fetch_site;
        proxy_read_timeout 90s;
    }
    location / { return 404; }
}
