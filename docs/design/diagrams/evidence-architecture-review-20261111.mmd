    opinionMap --> eligible["Agent 적격 후보의 전체 지지 출처"]
    eligible --> proposal["F4 원문 증거 그래프 제안"]
    sources --> proposal
    proposal --> observe["F4 원문 기반 유형 귀속 조건 전제 관측"]
    observe --> align["F4 후보 연결과 기존 완전성 검사"]
