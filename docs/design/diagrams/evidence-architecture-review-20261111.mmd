flowchart TB
    sources["F1 불변 댓글과 부모 문맥"] --> discover["F2 전체 발견과 후보 장부"]
    discover --> retrieve["F2 후보별 근거 검색"]
    sources --> retrieve
    retrieve --> mOne["F3 Jev M1 관계 관측"]
