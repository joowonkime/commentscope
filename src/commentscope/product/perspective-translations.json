      "name:MC5423718a87db97fcf6b999e546244e6b5869e36c66cce75ad292bbf06be142c2": {
        "sha256": "c68e5a70045088155051743a71143f21536b7f715912e771c999da39031f77a0",
        "en": "Proposal to adopt a 9-to-5 schedule"
