        "sha256": "c39d6995a97c48c976b4b84b74f8c4f7f4df4d604025f081673ab3445106f85d",
        "en": "Support for moving toward shorter working hours"
      },
      "claim:MC23d1bccab55e657ef99d7f4d0a64dde50775da1c31af89379d4a64e8c8e590c4:C": {
        "sha256": "3d4cd98e693773c7e6a267f653ab1bccd440070fc7316d73517f13c9bdfeaaa2",
        "en": "We should move toward shorter working hours."
