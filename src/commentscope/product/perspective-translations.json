      "issue": {
        "sha256": "c4629b65f2dd342a41ed9c434c283a6dfadf8007312416ef412083bc51b3cdde",
        "en": "How should South Korea change its working days and hours?"
      },
      "name:MC064d0983242f252130ad73720fb07cad1abef7a01c730f6fe0765ec152108bbf": {
        "sha256": "9ff88b59ffc8c83f3f07b7a3322f4722336e6b487c224de6f3aa9acbb1ef86e0",
        "en": "Proposal to finish work at 4 p.m."
      },
      "claim:MC064d0983242f252130ad73720fb07cad1abef7a01c730f6fe0765ec152108bbf:C": {
        "sha256": "5ca4367e0cb0b521e874dee49a9e09ba26d9a403102fa38f5ef9a42d8d6fca7c",
        "en": "I think working from 9 a.m. to 4 p.m. would be good."
      },
      "claim:SE989343a8863f8e9abf428b89ccaea25fc4bb3bc4feee82d02bf99fe6eec948c5": {
        "sha256": "1924eb7dc8d333255684ec35bd00a8faf9881ae4eec1ac99c407d233e1d512de",
        "en": "Getting off work one hour earlier feels awkward."
      },
      "name:MC218735dca1443fe1d4d162acf900e4a5b75dd19ce7a0ed0972f1dc9e15dc9d17": {
        "sha256": "afecd3c7bd48860ccaf3b97be3411960f8602df3991706bec0a772aa483b756a",
        "en": "Call to overhaul the inclusive wage system"
      },
      "claim:MC218735dca1443fe1d4d162acf900e4a5b75dd19ce7a0ed0972f1dc9e15dc9d17:C": {
        "sha256": "b86018d34d0a92137ba831f02373b0c6309d2d2d529e47d10780fd0a2d8cc6fa",
        "en": "The inclusive wage system needs an overhaul."
