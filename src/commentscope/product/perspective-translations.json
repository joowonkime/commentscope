      "claim:MC5423718a87db97fcf6b999e546244e6b5869e36c66cce75ad292bbf06be142c2:C": {
        "sha256": "2f8541b1ab2d26b692ca11055cfa3fd05445d596c953b85625158310e5a4a552",
        "en": "Let’s introduce a schedule that starts at 9 a.m. and ends at 5 p.m."
